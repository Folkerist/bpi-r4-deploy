#!/bin/sh /etc/rc.common
# AmneziaWG (userspace amneziawg-go) server awg0 for mobile clients.
# Config: /etc/amneziawg/awg0.conf ([Interface] + [Peer] blocks, awg setconf format).
# Firewall zone 'awg' (device awg0) is configured in /etc/config/firewall.
# procd runs this script's 'run' action: it starts the daemon and configures awg0 every time,
# so a respawned daemon gets its keys, peers and address back.
START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="run"
IFACE=awg0
ADDR=10.20.20.1/24
MTU=1420
CONF=/etc/amneziawg/$IFACE.conf

run() {
	[ -c /dev/net/tun ] || modprobe tun
	ip link del "$IFACE" 2>/dev/null
	/usr/bin/amneziawg-go -f "$IFACE" &
	pid=$!
	i=0
	while ! ip link show "$IFACE" >/dev/null 2>&1; do
		kill -0 $pid 2>/dev/null || { logger -t amneziawg "amneziawg-go exited"; exit 1; }
		[ $i -ge 30 ] && { logger -t amneziawg "$IFACE did not appear"; kill $pid; exit 1; }
		sleep 1; i=$((i+1))
	done
	if awg setconf "$IFACE" "$CONF" && ip addr replace "$ADDR" dev "$IFACE" && ip link set "$IFACE" mtu $MTU up; then
		logger -t amneziawg "$IFACE up"
	else
		logger -t amneziawg "$IFACE setup failed"; kill $pid; exit 1
	fi
	trap 'kill $pid 2>/dev/null' TERM INT
	wait $pid
	logger -t amneziawg "amneziawg-go stopped (exit $?)"
}

start_service() {
	[ -r "$CONF" ] || { logger -t amneziawg "$CONF missing"; return 1; }
	procd_open_instance
	procd_set_param command /etc/init.d/amneziawg run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	ip link del "$IFACE" 2>/dev/null
}

reload_service() {
	awg syncconf "$IFACE" "$CONF"
}
