{
	"luci-app-speedtest": {
		"description": "Run the router speed test (main uplink / LTE)",
		"read": {
			"file": {
				"/usr/bin/speedtest.sh status": [ "exec" ],
				"/usr/bin/speedtest.sh history": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/usr/bin/speedtest.sh start main": [ "exec" ],
				"/usr/bin/speedtest.sh start lte": [ "exec" ]
			}
		}
	}
}
