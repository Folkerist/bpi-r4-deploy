## Included into table inet fw4 from /etc/nftables.d/.
## Upstream networks mark downstream packets with DSCP (Yota LTE: AF11, tos 0x28; the wired
## uplink via 192.168.88.1: CS1, tos 0x20). mac80211 maps both to priority 1 = WMM Background
## (AC_BK), which capped Internet -> Wi-Fi traffic at ~20 Mbit/s while wired clients were fine.
## Clear the mark on packets arriving from any uplink (LTE modem and the wired WAN port).
chain wwan_dscp_reset {
	type filter hook prerouting priority mangle; policy accept;
	iifname "wwan*" ip dscp set cs0 counter
	iifname "wwan*" ip6 dscp set cs0 counter
	iifname "wan" ip dscp set cs0 counter
	iifname "wan" ip6 dscp set cs0 counter
}
