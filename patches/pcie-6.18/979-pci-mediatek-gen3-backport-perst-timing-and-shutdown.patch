From: Jian Yang <jian.yang@mediatek.com>
Subject: [PATCH] PCI: mediatek-gen3: backport PERST# timing fix and .shutdown()
 callback (upstream 22fc8822d146 + 7a0e17e7a081)

Backport of two upstream commits (merged for v7.2-rc1) to Linux 6.18.
Upstream depends on the v7.1 pwrctrl rework (mtk_pcie_devices_power_up()/
mtk_pcie_devices_power_down()), which does not exist in 6.18, so the logic
is folded into mtk_pcie_startup_port() here. Semantics are identical to
upstream for all non-Airoha SoCs (MT7988, MT8192, MT8196):

 1) commit 22fc8822d146 ("PCI: mediatek-gen3: Fix PERST# control timing
    during system startup")

    Some MediaTek chips stop generating REFCLK while PCIE_PHY_RSTB is
    asserted. The old code de-asserted PCIE_PHY_RSTB together with
    PCIE_PE_RSTB (PERST#), so PERST# was released at the same moment
    REFCLK restarted, violating PCIe CEM r6.0 sec 2.11.2 (TPVPERL).
    New sequence:
      assert MAC|PHY|BRG|PERST# -> 10ms (PCIE_BRG_RST_RDY_MS) ->
      de-assert MAC|PHY|BRG -> 100ms (PCIE_T_PVPERL_MS) -> de-assert PERST#

 2) commit 7a0e17e7a081 ("PCI: mediatek-gen3: Add a .shutdown() callback
    to control PERST# signal")

    Assert PERST# and power the controller down on shutdown/reboot so the
    endpoint sees a proper reset before power/clock goes away.

Differences from upstream (6.18 has no pwrctrl hooks here):
 - pci_pwrctrl_power_on/off_devices() calls are not present in 6.18;
 - the 10ms wait is kept inside the !SKIP_PCIE_RSTB branch, so the
   Airoha EN7581 path is left exactly as in 6.18 (upstream sleeps
   unconditionally);
 - .shutdown() open-codes mtk_pcie_devices_power_down() (PERST# assert).

Applies after 966-pcie-mediatek-gen3-Add-WIFI-HW-reset-flow.patch.
Not in linux-6.18.y stable. Drop this patch once OpenWrt moves to a
kernel >= 7.2.

Link: https://patch.msgid.link/20260413071401.1151-2-jian.yang@mediatek.com
Link: https://patch.msgid.link/20260413071401.1151-3-jian.yang@mediatek.com
Signed-off-by: Jian Yang <jian.yang@mediatek.com>
Signed-off-by: Manivannan Sadhasivam <mani@kernel.org>
Signed-off-by: Bjorn Helgaas <bhelgaas@google.com>
[backported to 6.18 for OpenWrt, not upstream code]
---
 drivers/pci/controller/pcie-mediatek-gen3.c | 43 +++++++++++++++++++++++++++--
 1 file changed, 40 insertions(+), 3 deletions(-)

--- a/drivers/pci/controller/pcie-mediatek-gen3.c
+++ b/drivers/pci/controller/pcie-mediatek-gen3.c
@@ -63,6 +63,12 @@
 #define PCIE_BRG_RSTB			BIT(2)
 #define PCIE_PE_RSTB			BIT(3)
 
+/*
+ * As described in the datasheet of MediaTek PCIe Gen3 controller, wait 10ms
+ * after setting PCIE_BRG_RSTB, and before accessing PCIe internal registers.
+ */
+#define PCIE_BRG_RST_RDY_MS		10
+
 #define PCIE_LTSSM_STATUS_REG		0x150
 #define PCIE_LTSSM_STATE_MASK		GENMASK(28, 24)
 #define PCIE_LTSSM_STATE(val)		((val & PCIE_LTSSM_STATE_MASK) >> 24)
@@ -490,6 +496,19 @@ static int mtk_pcie_startup_port(struct mtk_gen3_pcie *pcie)
 		       PCIE_PE_RSTB;
 		writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
 
+		/*
+		 * Some of MediaTek's chips won't output REFCLK when PCIE_PHY_RSTB is
+		 * asserted, we have to de-assert MAC & PHY & BRG reset signals first
+		 * to allow the REFCLK to be stable. While PCIE_BRG_RSTB is asserted,
+		 * there is a short period during which the PCIe internal register
+		 * cannot be accessed, so we need to wait 10ms here.
+		 */
+		msleep(PCIE_BRG_RST_RDY_MS);
+
+		/* De-assert MAC, PHY and BRG reset signals */
+		val &= ~(PCIE_MAC_RSTB | PCIE_PHY_RSTB | PCIE_BRG_RSTB);
+		writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
+
 		/*
 		 * Described in PCIe CEM specification revision 6.0.
 		 *
@@ -498,9 +517,8 @@ static int mtk_pcie_startup_port(struct mtk_gen3_pcie *pcie)
 		 */
 		msleep(PCIE_T_PVPERL_MS);
 
-		/* De-assert reset signals */
-		val &= ~(PCIE_MAC_RSTB | PCIE_PHY_RSTB | PCIE_BRG_RSTB |
-			 PCIE_PE_RSTB);
+		/* De-assert PERST# signal */
+		val &= ~PCIE_PE_RSTB;
 		writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
 	}
 
@@ -1254,6 +1272,24 @@ static void mtk_pcie_remove(struct platform_device *pdev)
 	mtk_pcie_power_down(pcie);
 }
 
+static void mtk_pcie_shutdown(struct platform_device *pdev)
+{
+	struct mtk_gen3_pcie *pcie = platform_get_drvdata(pdev);
+	u32 val;
+
+	/*
+	 * PCIe CEM r6.0, sec 2.2: PERST# must be asserted before the power
+	 * to the connector is removed (or the SoC is reset on reboot).
+	 */
+	if (!(pcie->soc->flags & SKIP_PCIE_RSTB)) {
+		val = readl_relaxed(pcie->base + PCIE_RST_CTRL_REG);
+		val |= PCIE_PE_RSTB;
+		writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
+	}
+
+	mtk_pcie_power_down(pcie);
+}
+
 static void mtk_pcie_irq_save(struct mtk_gen3_pcie *pcie)
 {
 	int i;
@@ -1397,6 +1433,7 @@ MODULE_DEVICE_TABLE(of, mtk_pcie_of_match);
 static struct platform_driver mtk_pcie_driver = {
 	.probe = mtk_pcie_probe,
 	.remove = mtk_pcie_remove,
+	.shutdown = mtk_pcie_shutdown,
 	.driver = {
 		.name = "mtk-pcie-gen3",
 		.of_match_table = mtk_pcie_of_match,
